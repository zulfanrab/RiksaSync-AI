  var totalBaris = 0;
  for (var tabName in DATA_HISTORIS) {
    var rows = DATA_HISTORIS[tabName];
    if (!rows || rows.length === 0) continue;

    var sheet = ss.getSheetByName(tabName);
    if (!sheet) continue;

    // Bersihkan baris lama dari baris 5 ke bawah jika ada
    var lastRow = sheet.getLastRow();
    if (lastRow >= 5) {
      sheet.getRange(5, 1, lastRow - 4, 8).clearContent().clearFormat();
    }

    // Bulk insert seluruh baris sekaligus
    var range = sheet.getRange(5, 1, rows.length, 8);
    range.setValues(rows);

    // Styling
    sheet.getRange(5, 1, rows.length, 1).setHorizontalAlignment("center").setFontWeight("bold");
    sheet.getRange(5, 2, rows.length, 1).setHorizontalAlignment("center");
    sheet.getRange(5, 8, rows.length, 1).setHorizontalAlignment("center");

    // Format coret untuk yang statusnya batal
    for (var r = 0; r < rows.length; r++) {
      if (rows[r][7] && rows[r][7].indexOf("BATAL") !== -1) {
        sheet.getRange(5 + r, 1, 1, 8).setFontStrikeThrough(true).setFontColor("#94a3b8");
      }
    }

    var nowStr = Utilities.formatDate(new Date(), "Asia/Jakarta", "dd/MM/yyyy HH:mm:ss");
    sheet.getRange("H2").setValue("Terakhir disinkron: " + nowStr + " WIB");

    totalBaris += rows.length;
    Logger.log("✅ Tab '" + tabName + "' berhasil diisi: " + rows.length + " baris.");
  }

  SpreadsheetApp.flush();
  Logger.log("🎉 SELESAI! Total " + totalBaris + " data historis berhasil dimasukkan ke seluruh tab!");
